{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API for Real Estate Platform",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0 <22.0.0"
  },
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "ts-node src/scripts/seed.ts",
    "prebuild": "sed -i 's/\"moduleResolution\":\\s*\"node10\"/\"moduleResolution\": \"node\"/g' tsconfig.json 2>/dev/null || echo '✅ tsconfig already fixed'"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.6.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "cloudinary": "^1.41.0",
    "multer": "^1.4.5-lts.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "nodemailer": "^6.9.7",
    "express-validator": "^7.0.1",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/cors": "^2.8.17",
    "@types/multer": "^1.4.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/express-rate-limit": "^6.0.1",
    "@types/nodemailer": "^6.4.14",
    "@types/validator": "^13.11.9",
    "typescript": "^5.3.3",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.2"
  }
}
